[node name="GuideShortcutsLabel" type="Label" parent="MainVBox/BodyHBox/RightSidebar/Scroll/Margin/VBox/GuideCard/GuideVBox" unique_id=1212519015]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "• 数字键 1/2/3/4: 切换 挂载/枢轴/枪口/标靶 模式
• F 键: 手动发射投射物攻击标靶
• 空格键: 开始/暂停 炮塔自动匀速旋转
• R 键: 炮塔朝向立即复位至 0.0°
• Shift + 左键: 在点击处快速创建枪口
• 左键拖拽标靶: 随意改变受击目标位置测试弹道与导弹追踪
• Ctrl + S: 一键保存当前单位与武器配置
• 鼠标中键/右键: 自由平移画布视口
