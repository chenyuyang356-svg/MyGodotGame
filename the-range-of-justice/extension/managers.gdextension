[configuration]

entry_symbol = "my_gdextension_library_init"
compatibility_minimum = "4.1"
reloadable = true

[libraries]

windows.editor.x86_64 = "res://extension/bin/libgdextension.windows.template_debug.x86_64.dll"
windows.template_debug.x86_64 = "res://extension/bin/libgdextension.windows.template_debug.x86_64.dll"
windows.template_release.x86_64 = "res://extension/bin/libgdextension.windows.template_release.x86_64.dll"
windows.debug.x86_64 = "res://extension/bin/libgdextension.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://extension/bin/libgdextension.windows.template_release.x86_64.dll"
windows.x86_64 = "res://extension/bin/libgdextension.windows.template_debug.x86_64.dll"
windows = "res://extension/bin/libgdextension.windows.template_debug.x86_64.dll"
