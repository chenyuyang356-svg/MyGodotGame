import os
import sys

# Load godot-cpp build script
env = SConscript("godot-cpp/SConstruct")

# Add include paths
env.Append(CPPPATH=["src/"])

# Collect all C++ source files in src/
sources = Glob("src/*.cpp")

# Build shared library into bin/libgdextension
library = env.SharedLibrary(
    "bin/libgdextension",
    source=sources,
)

# 按 Godot 期望的命名复制，支持 debug / release 双目标：
#   scons                      -> template_debug
#   scons target=template_release -> template_release
# 产出形如 libgdextension.windows.template_debug.x86_64.dll
target_name = "libgdextension.{}.{}.{}.dll".format(
    env.get("platform", "windows"),
    env.get("target", "template_debug"),
    env.get("arch", "x86_64"),
)
copy_target = env.Command(
    "bin/" + target_name,
    library,
    Copy("$TARGET", "$SOURCE"),
)

Default(library, copy_target)
